@model OnlineStore.Models.DTO.UserDTO

@{
    ViewBag.Title = "Registration";
}

@section Header {
    <h1>Registration</h1>
}

<div class="container h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-lg-12 col-xl-11">
            <div class="card text-black" style="border-radius: 25px;">
                <div class="card-body p-md-5">
                    <div class="row justify-content-center">
                        <div class="col-md-10 col-lg-6 col-xl-5 order-2 order-lg-1">
                            @using (Html.BeginForm("RegisterPost", "User", FormMethod.Post, htmlAttributes: new { @class = "mx-1 mx-md-4" }))
                            {
                                <div class="d-flex flex-row align-items-center mb-4">
                                    <i class="bi bi-person-fill text-body me-3 fs-2"></i>
                                    <div class="form-floating form-outline flex-fill mb-0">
                                        @Html.TextBoxFor(Model => Model.Username, htmlAttributes: new { @class = "form-control", @id = "username", @placeholder = "Username"})
                                        @Html.LabelFor(Model => Model.Username, htmlAttributes: new { @class = "form-label", @for = "username" })
                                    </div>
                                </div>

                                <div class="d-flex flex-row align-items-center mb-4">
                                    <i class="bi bi-envelope-fill text-body me-3 fs-2"></i>
                                    <div class="form-floating form-outline flex-fill mb-0">
                                        @Html.TextBoxFor(Model => Model.Email, htmlAttributes: new { @class = "form-control", @id = "email", @placeholder = "E-mail" })
                                        @Html.LabelFor(Model => Model.Email, htmlAttributes: new { @class = "form-label", @for = "email" })
                                    </div>
                                </div>

                                <div class="d-flex flex-row align-items-center mb-4">
                                    <i class="bi bi-unlock2-fill text-body me-3 fs-2"></i>
                                    <div class="form-floating form-outline flex-fill mb-0">
                                        @Html.PasswordFor(Model => Model.Password, htmlAttributes: new { @class = "form-control", @id = "password", @placeholder = "Password" })
                                        @Html.LabelFor(Model => Model.Password, htmlAttributes: new { @class = "form-label", @for = "password" })
                                    </div>
                                </div>

                                <div class="d-flex justify-content-center mx-4 mb-3 mb-lg-4">
                                    <button type="submit" class="btn btn-primary btn-lg">Register</button>
                                </div>
                            }
                        </div>
                        <div class="col-md-10 col-lg-6 col-xl-7 d-flex align-items-center order-1 order-lg-2">
                            <img src="https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Fstatic.vecteezy.com%2Fsystem%2Fresources%2Fpreviews%2F000%2F670%2F721%2Foriginal%2Fvector-woman-online-shopping-with-smartphone-technology-graphic.jpg&f=1&nofb=1&ipt=ccd0aa874210f81e42f001694f86884a352d57a2f65a704a4f547c0c3f7b126f"
                                 class="img-fluid" alt="Sample image">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
