@using OnlineStore.Helpers.Html
@model OnlineStore.Models.View.ProductPageModel

@section Header {
    <h1>@Model.Product.Name</h1>
}

<p>Description: @Model.Product.Description</p>

<div id="reviews" class="mb-3">
    <h3 class="mb-3">Reviews</h3>

    @* TODO breaks in pagination if too many pages *@
    @if (Model.ReviewContainer.MaxPage > 1)
    {
        <div class="container-fluid mt-3">
            <ul class="pagination position-relative bottom-0">
                @if (Model.ReviewContainer.CurPage > 0)
                {
                    <li class="page-item"><a asp-route-page="@(Model.ReviewContainer.CurPage - 1)" class="page-link">&lt;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><a asp-route-page="@(Model.ReviewContainer.CurPage - 1)" class="page-link">&lt;</a></li>
                }

                @for (int i = 0; i < Model.ReviewContainer.CurPage; i++)
                {
                    <li class="page-item"><a asp-route-page="@(i)" class="page-link">@(i + 1)</a></li>
                }

                <li class="page-item active">
                    <a asp-route-page="@(Model.ReviewContainer.CurPage)" class="page-link">
                        @(Model.ReviewContainer.CurPage + 1)
                    </a>
                </li>

                @for (int i = Model.ReviewContainer.CurPage + 1; i < Model.ReviewContainer.MaxPage + 1; i++)
                {
                    <li class="page-item"><a asp-route-page="@(i)" class="page-link">@(i + 1)</a></li>
                }

                @if (Model.ReviewContainer.CurPage < Model.ReviewContainer.MaxPage)
                {
                    <li class="page-item"><a asp-route-page="@(Model.ReviewContainer.CurPage + 1)" class="page-link">&gt;</a></li>
                }
                else
                {
                    <li class="page-item disabled"><a asp-route-page="@(Model.ReviewContainer.CurPage + 1)" class="page-link">&gt;</a></li>
                }
            </ul>
        </div>
    }

    <div class="mb-3">
        @foreach (var review in Model.ReviewContainer.Items)
        {
            @Html.Review(review)
        }
    </div>

    <div class="mb-3">
        @using (Html.BeginForm("AddReview", "Product", FormMethod.Post))
        {
            <div class="form-group mb-3">
                @Html.LabelFor(Model => Model.NewReview.Username, "Your name:", htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(Model => Model.NewReview.Username)
            </div>
            <div class="form-group mb-3">
                @Html.LabelFor(Model => Model.NewReview.Rating, "Your rating:", htmlAttributes: new { @class = "form-label" })
                @Html.RadioButtonFor(Model => Model.NewReview.Rating, 1, htmlAttributes: new { id = "rating1" })
                <label for="rating1">1</label>
                @Html.RadioButtonFor(Model => Model.NewReview.Rating, 2, htmlAttributes: new { id = "rating2" })
                <label for="rating2">2</label>
                @Html.RadioButtonFor(Model => Model.NewReview.Rating, 3, htmlAttributes: new { id = "rating3" })
                <label for="rating3">3</label>
                @Html.RadioButtonFor(Model => Model.NewReview.Rating, 4, htmlAttributes: new { id = "rating4" })
                <label for="rating4">4</label>
                @Html.RadioButtonFor(Model => Model.NewReview.Rating, 5, htmlAttributes: new { id = "rating5" })
                <label for="rating5">5</label>
            </div>
            <div class="form-group mb-3 w-50">
                @Html.LabelFor(Model => Model.NewReview.Text, "Your review:", htmlAttributes: new { @class = "form-label" })
                @Html.TextAreaFor(Model => Model.NewReview.Text);
            </div>
            @Html.HiddenFor(Model => Model.NewReview.ProductID, Model.Product.Id);
            <button class="btn btn-primary" type="submit">Submit</button>
        }
    </div>
</div>
